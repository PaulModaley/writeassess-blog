# Sanity project — get from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for on-demand ISR webhook. Generate with: openssl rand -hex 32
# Must match the ?secret= param in the Sanity webhook URL.
SANITY_REVALIDATE_SECRET=your_secret_here
